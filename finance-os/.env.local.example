# Copy to .env.local and fill in from the Supabase project dashboard
# (Project Settings → API). Never commit .env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Credentials for the shared "Try Demo" login button (server-only — never
# NEXT_PUBLIC_). Must match the fixed demo user reset_demo_data() creates
# (supabase/migrations/20260902000000_create_reset_demo_data_function.sql).
DEMO_USER_EMAIL=demo@example.com
DEMO_USER_PASSWORD=devpassword123
